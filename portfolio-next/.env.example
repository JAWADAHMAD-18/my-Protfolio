# Contact form
FORMSPREE_ENDPOINT=

# Rate limiting. When both are set, chat and contact limits use Upstash.
# Otherwise the app keeps an in-memory limit for the current server process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Knowledge base embeddings (`npm run build:kb`) and query embedding at chat time.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001

# Streaming replies for /api/chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
